<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mini_city">

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- =========================
         Ground platform
         ========================= -->
    <model name="ground_platform">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>50 50 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>50 50 1</size></box>
          </geometry>
          <material>
            <script><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>
    </model>

    <!-- =========================
         Simple roads (2 strips)
         ========================= -->
    <model name="road_x">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>45 4 0.02</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>45 4 0.02</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="road_y">
      <static>true</static>
      <pose>0 0 0.011 0 0 1.570796</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>45 4 0.02</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>45 4 0.02</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =========================
         Buildings (your originals)
         ========================= -->
    <model name="building_north">
      <static>true</static>
      <pose>10 0 5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>5 5 10</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>5 5 10</size></box></geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="building_south">
      <static>true</static>
      <pose>-10 0 3 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4 4 6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>4 4 6</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="tower">
      <static>true</static>
      <pose>0 12 8 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>2</radius><length>16</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>2</radius><length>16</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =========================
         Trees (simple cylinders + canopy)
         ========================= -->
    <model name="tree_1">
      <static>true</static>
      <pose>6 6 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_col">
          <pose>0 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <pose>0 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient></material>
        </visual>

        <collision name="canopy_col">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
        </collision>
        <visual name="canopy_vis">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
          <material><ambient>0.05 0.4 0.05 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-6 7 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_col">
          <pose>0 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <pose>0 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient></material>
        </visual>

        <collision name="canopy_col">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
        </collision>
        <visual name="canopy_vis">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
          <material><ambient>0.05 0.4 0.05 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =========================
         Car (simple box)
         ========================= -->
    <model name="car_1">
      <static>true</static>
      <pose>0 -8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.8 0.9 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.8 0.9 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.0 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =========================
         Spawn YOUR custom drone
         (blue payload + lidar)
         ========================= -->
    <include>
      <uri>model://iris_custom</uri>
      <pose>0 0 1.0 0 0 0</pose>
    </include>

  </world>
</sdf>

